{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/form-writer/form.schema.json",
  "title": "form_writer PoC schema",
  "type": "object",
  "required": ["form_code", "schema_version", "title", "template_type", "sections"],
  "properties": {
    "form_code": {"type":"string", "minLength":1},
    "schema_version": {"type":"string", "minLength":1},
    "title": {"type":"string", "minLength":1},
    "template_type": {"enum":["inspection_checklist","measurement_grid","decision_matrix"]},
    "sections": {
      "type":"array", "minItems":1,
      "items": {
        "type":"object", "required":["id","type","title"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "type":{"enum":["fields","checklist","measurement_grid","decision_matrix","defect_review","signatures","remarks"]},
          "title":{"type":"string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
